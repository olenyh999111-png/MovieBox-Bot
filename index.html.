<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#080a12">
<title>MovieBox — Кинотека</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root{color-scheme:dark;--bg:#080a12;--panel:#121624;--blue:#4b83ff;--muted:#929bb1}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:#fff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
header{padding:24px 18px 14px;background:linear-gradient(140deg,#14244a,#080a12 75%)}
.brand{font-size:26px;font-weight:900;letter-spacing:-1px}.brand span{color:#5c91ff}
.sub{color:#aeb8d0;font-size:13px;margin-top:5px}
.wrap{padding:16px 16px 100px;max-width:760px;margin:auto}
.search{display:flex;gap:9px;margin:4px 0 22px}
input{min-width:0;flex:1;background:#171c2b;border:1px solid #272e42;border-radius:13px;padding:14px;color:white;font-size:16px;outline:none}
button{border:0;border-radius:12px;padding:12px 15px;background:var(--blue);color:white;font-weight:700;font-size:14px;cursor:pointer}
h2{font-size:19px;margin:20px 0 13px}
.hero{background:linear-gradient(120deg,#1c3160,#151b2c);border:1px solid #293858;border-radius:18px;padding:20px;margin-bottom:22px}
.hero small{color:#9cbaff;font-weight:700;text-transform:uppercase;letter-spacing:1.5px}
.hero h1{font-size:25px;margin:10px 0}.hero p{color:#c3cce0;line-height:1.5;font-size:14px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.movie{overflow:hidden;background:var(--panel);border:1px solid #22283a;border-radius:15px}
.poster{height:190px;display:flex;align-items:center;justify-content:center;font-size:58px;background:linear-gradient(145deg,#243b68,#10131f)}
.movie-info{padding:11px}
.movie h3{font-size:15px;margin:0 0 6px;line-height:1.3}
.meta{color:var(--muted);font-size:12px;margin-bottom:10px}
.movie button{width:100%;padding:10px;font-size:12px}
.empty{padding:24px 8px;color:var(--muted);text-align:center;grid-column:1/-1}
.actions{display:grid;gap:10px;margin-top:24px}
.secondary{background:#1a2030;border:1px solid #30384c}
footer{text-align:center;color:#778198;font-size:12px;padding:25px 5px}
nav{position:fixed;bottom:0;left:0;right:0;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:#0b0e18f2;border-top:1px solid #242a3a;display:flex;justify-content:center;z-index:5}
nav button{width:100%;max-width:720px}
@media(min-width:540px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.poster{height:220px}}
</style>
</head>
<body>
<header>
  <div class="brand">MOVIE<span>BOX</span></div>
  <div class="sub">Твоя кинотека — фильмы в одном месте</div>
</header>
<main class="wrap">
  <section class="hero">
    <small>MovieBox experience</small>
    <h1>Что будем смотреть?</h1>
    <p>Ищи кино, изучай подборку и переходи в нашего Telegram-бота за дополнительными возможностями.</p>
    <button onclick="openBot()">Открыть Telegram-бота ↗</button>
  </section>
  <div class="search">
    <input id="query" type="search" placeholder="Название фильма..." aria-label="Поиск фильмов">
    <button onclick="renderMovies()">Найти</button>
  </div>
  <h2 id="sectionTitle">Популярная подборка</h2>
  <section class="grid" id="movies"></section>
  <section class="actions">
    <button onclick="openBot()">Перейти к @MovieBoxFinderBot</button>
    <button class="secondary" onclick="shareApp()">Поделиться приложением</button>
  </section>
  <footer>MovieBox · Каталог и доступ к Telegram-боту</footer>
</main>
<nav><button onclick="openBot()">Запустить MovieBox в Telegram ↗</button></nav>
<script>
const tg = window.Telegram?.WebApp;
tg?.ready();
tg?.expand();

const botUrl = "https://t.me/MovieBoxFinderBot";

const catalog = [
 {title:"Интерстеллар",year:2014,genre:"Фантастика",emoji:"🚀"},
 {title:"Начало",year:2010,genre:"Триллер",emoji:"🌀"},
 {title:"Джентльмены",year:2019,genre:"Криминал",emoji:"🕴️"},
 {title:"Гарри Поттер",year:2001,genre:"Фэнтези",emoji:"⚡"},
 {title:"Матрица",year:1999,genre:"Фантастика",emoji:"🟩"},
 {title:"Гладиатор",year:2000,genre:"Драма",emoji:"⚔️"},
 {title:"Дюна",year:2021,genre:"Фантастика",emoji:"🏜️"},
 {title:"Пираты Карибского моря",year:2003,genre:"Приключения",emoji:"🏴‍☠️"}
];

function renderMovies(){
 const q=document.getElementById("query").value.trim().toLowerCase();
 const list=catalog.filter(m=>
  (m.title+" "+m.year+" "+m.genre).toLowerCase().includes(q)
 );
 document.getElementById("sectionTitle").textContent=
  q?"Результаты поиска":"Популярная подборка";

 const container=document.getElementById("movies");
 container.innerHTML="";

 if(!list.length){
  container.innerHTML='<div class="empty">В демо-каталоге ничего не найдено. Попробуй другое название или открой бота.</div>';
  return;
 }

 list.forEach(m=>{
  const card=document.createElement("article");
  card.className="movie";
  card.innerHTML=`<div class="poster" aria-hidden="true">${m.emoji}</div><div class="movie-info"><h3></h3><div class="meta"></div><button>Подробнее</button></div>`;
  card.querySelector("h3").textContent=m.title;
  card.querySelector(".meta").textContent=m.year+" · "+m.genre;
  card.querySelector("button").onclick=()=>showDetails(m);
  container.appendChild(card);
 });
}

function showDetails(m){
 const message=m.title+" ("+m.year+") — "+m.genre+". Открой Telegram-бота для дальнейшего поиска.";
 if(tg?.showPopup){
  tg.showPopup(
   {title:m.title,message,buttons:[
    {id:"bot",type:"default",text:"Открыть бота"},
    {type:"cancel"}
   ]},
   (id)=>{if(id==="bot")openBot();}
  );
 } else {
  alert(message);
 }
}

function openBot(){
 if(tg?.openTelegramLink) tg.openTelegramLink(botUrl);
 else window.location.href=botUrl;
}

function shareApp(){
 if(tg?.switchInlineQuery) tg.switchInlineQuery("MovieBox — кинотека",[]);
 else if(navigator.share)
  navigator.share({title:"MovieBox",text:"Открой MovieBox в Telegram",url:location.href}).catch(()=>{});
 else if(navigator.clipboard)
  navigator.clipboard.writeText(location.href)
   .then(()=>alert("Ссылка скопирована"))
   .catch(()=>alert(location.href));
 else alert(location.href);
}

document.getElementById("query").addEventListener("input",renderMovies);
document.getElementById("query").addEventListener("keydown",e=>{
 if(e.key==="Enter")renderMovies();
});

renderMovies();
</script>
</body>
</html>
